generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Lowongan Pekerjaan
model JobPosting {
  id           Int         @id @default(autoincrement())
  title        String
  department   String
  location     String      @default("Karawang / Cikarang")
  type         String      @default("Full-Time")
  experience   String      @default("1-3 Tahun")
  requirements String      @db.Text
  description  String      @db.Text
  isOpen       Boolean     @default(true) @map("is_open")
  createdAt    DateTime    @default(now()) @map("created_at")
  applicants   Applicant[]

  @@map("job_postings")
}

// 2. Data Pelamar & Pelacak 7 Tahap Seleksi
model Applicant {
  id               Int                 @id @default(autoincrement())
  jobPostingId     Int                 @map("job_posting_id")
  jobPosting       JobPosting          @relation(fields: [jobPostingId], references: [id])
  fullName         String              @map("full_name")
  email            String              @unique
  password         String              // bcrypt
  phone            String
  birthDate        DateTime            @map("birth_date")
  age              Int
  lastEducation    String              @map("last_education")
  schoolName       String              @map("school_name")
  major            String
  experience       String
  englishSkill     String              @map("english_skill")
  otherLanguages   String              @map("other_languages")
  cvFile           String              @map("cv_file") // Base64 data URI atau file name
  cvFileSize       Int                 @default(0) @map("cv_file_size") // <= 100 KB
  
  // Progress Seleksi 1 s/d 7
  currentStage        Int                 @default(1) @map("current_stage") 
  stageStatus         String              @default("in_progress") @map("stage_status") // in_progress, passed, failed
  failedAtStage       Int?                @map("failed_at_stage")
  rejectionReason     String?             @map("rejection_reason") @db.Text
  
  // Screening
  screeningNotes      String?             @map("screening_notes") @db.Text

  // Jadwal, Lokasi & Token Sesi Tes Online
  psikotesScheduledAt DateTime?           @map("psikotes_scheduled_at")
  psikotesToken       String?             @map("psikotes_token")
  psikotesLocation    String?             @default("Portal Karir Online PT ITSP") @map("psikotes_location")
  userTestScheduledAt DateTime?           @map("user_test_scheduled_at")
  userTestToken       String?             @map("user_test_token")
  userTestLocation    String?             @default("Portal Karir Online PT ITSP") @map("user_test_location")
  
  // MCU & Offering
  mcuNotes            String?             @map("mcu_notes") @db.Text
  offeringLetter      String?             @map("offering_letter") @db.Text
  offeringSalary      String?             @map("offering_salary")
  offeringStatus      String              @default("pending") @map("offering_status") // pending, issued, accepted, rejected
  contractSignedAt    DateTime?           @map("contract_signed_at")
  
  createdAt           DateTime            @default(now()) @map("created_at")
  
  // Relasi
  testSubmissions     TestSubmission[]
  interviews          InterviewSchedule[]
  karyawanData        KaryawanSementara?

  @@map("applicants")
}

// 3. Jadwal Interview HR & User
model InterviewSchedule {
  id              Int       @id @default(autoincrement())
  applicantId     Int       @map("applicant_id")
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewType   String    @map("interview_type") // 'hr' atau 'user'
  scheduledAt     DateTime  @map("scheduled_at")
  locationMode    String    @default("online") @map("location_mode") // 'online' atau 'onsite'
  meetingPlatform String?   @default("teams") @map("meeting_platform") // teams, zoom, google_meet
  meetingLink     String?   @map("meeting_link")
  meetingPasscode String?   @map("meeting_passcode")
  locationAddress String?   @map("location_address")
  roomName        String?   @map("room_name")
  interviewerName String?   @map("interviewer_name")
  notes           String?   @db.Text
  status          String    @default("scheduled") // scheduled, completed, cancelled
  feedback        String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("interview_schedules")
}

// 4. Bank Soal Tes Psikotes & Tes User
model TestQuestion {
  id          Int      @id @default(autoincrement())
  category    String   // 'psikotes' atau 'user_test'
  department  String?  // 'General', 'Engineering', 'IT', 'HSE', 'Purchasing'
  question    String   @db.Text
  questionType String  @default("single_choice") @map("question_type") // 'single_choice', 'multi_choice' (personality profiling), 'essay' (uraian teknis)
  imageUrl    String?  @db.Text @map("image_url") // Gambar diagram teknis, grafik, pola logika, gambar mold
  options     String   @db.Text // JSON string [A, B, C, D] (kosong jika essay)
  correctKey  String?  @map("correct_key") // A, B, C, D (opsional / null untuk profiling & essay)
  points      Int      @default(10)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("test_questions")
}

// 5. Hasil Ujian & Log Anti-Cheat
model TestSubmission {
  id              Int       @id @default(autoincrement())
  applicantId     Int       @map("applicant_id")
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  testType        String    @map("test_type") // 'psikotes' atau 'user_test'
  score           Int?      @default(0)
  showScore       Boolean   @default(false) @map("show_score") // Privasi nilai
  answers         String    @db.Text // JSON string jawaban
  violationsCount Int       @default(0) @map("violations_count") // Strike pindah tab / alt-tab
  isLocked        Boolean   @default(false) @map("is_locked")
  isPassed        Boolean?  @map("is_passed")
  startedAt       DateTime? @map("started_at")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("test_submissions")
}

// 6. Karyawan Sementara (Siap Sinkronisasi & Cetak ID Card)
model KaryawanSementara {
  id               Int       @id @default(autoincrement())
  applicantId      Int       @unique @map("applicant_id")
  applicant        Applicant @relation(fields: [applicantId], references: [id])
  nikSementara     String    @unique @map("nik_sementara")
  namaLengkap      String    @map("nama_lengkap")
  email            String
  noHp             String    @map("no_hp")
  departemen       String
  jabatan          String
  tanggalBergabung DateTime  @map("tanggal_bergabung")
  statusIntegrasi  String    @default("ready") @map("status_integrasi") // ready, synced
  idCardPrinted    Boolean   @default(false) @map("id_card_printed")
  photoUrl         String?   @map("photo_url")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("karyawan_sementara")
}

// 7. Pengguna Admin HR & User Internal (Dengan MFA TOTP)
model RecruitmentAdmin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String   @unique
  password     String   // bcrypt
  role         String   @default("hr") // 'hr', 'user_dept', 'admin'
  department   String?
  mfaSecret    String?  @map("mfa_secret")
  isMfaEnabled Boolean  @default(false) @map("is_mfa_enabled")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("recruitment_admins")
}

// 8. Pengaturan Master Default (Klinik MCU, Biaya, Alamat Pabrik)
model RecruitmentSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recruitment_settings")
}
