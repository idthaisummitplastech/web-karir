DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/web_karir?schema=public"
# WAJIB via env di semua environment (min 32 karakter acak). Tanpa fallback di code.
# Contoh generate: openssl rand -hex 32
JWT_SECRET="change-me-min-32-chars-via-env"
BACKEND_INTERNAL_SECRET="change-me-min-32-chars-via-env"

# Backend & URL publik — 100% via env, tanpa hardcoded di code (lihat src/lib/urls.ts).
# Ganti domain cukup sentuh .env.
# Port runtime: backend:8004, web-karir:3009, web-perusahaan:3008.
BACKEND_API_URL="http://localhost:8004/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3009"
CAREER_SITE_URL="http://localhost:3009"
NEXT_PUBLIC_COMPANY_URL="http://localhost:3008"
COMPANY_SITE_URL="http://localhost:3008"
PORT=3009

# SMTP — 100% via env (lihat src/lib/email.ts). Tanpa host/email hardcoded di code.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="PT ITSP Recruitment"
# Opsional override split-DNS kantor (kosongkan bila tidak dipakai).
SMTP_TARGET_HOST=""
SMTP_TLS_SNI=""

# Grafana OTLP — 100% via env (lihat src/lib/grafana.ts). Kosongkan bila tidak dipakai (no-op).
GRAFANA_OTLP_URL=""
GRAFANA_AUTH_HEADER=""
GRAFANA_DASHBOARD_URL=""

# Seed passwords (min 12 karakter) — WAJIB via env untuk `prisma db seed`.
SEED_ADMIN_PASSWORD="change-me-min-12-chars"
